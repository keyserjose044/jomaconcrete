---
import BaseLayout from '../layouts/BaseLayout.astro';

// Add project images to /public/images_webp and list them here:
const photos = [
  '/images_webp/1.jpg',
  '/images_webp/2.jpg',
  '/images_webp/3.jpg',
  '/images_webp/4.jpg',
  '/images_webp/5.jpg',
  '/images_webp/6.jpg',
  '/images_webp/7.jpg',
  '/images_webp/8.jpg',
  '/images_webp/9.jpg',
  '/images_webp/10.jpg',
  '/images_webp/11.jpg',
  '/images_webp/12.jpg',
  '/images_webp/13.jpg',
  '/images_webp/14.jpg',
  '/images_webp/15.jpg',
  '/images_webp/16.jpg',
  '/images_webp/17.jpg',
  '/images_webp/18.jpg',
  '/images_webp/19.jpg',
  '/images_webp/20.jpg',
  '/images_webp/21.jpg',
  '/images_webp/22.jpg',
  '/images_webp/23.jpg',
  '/images_webp/24.jpg',
  '/images_webp/25.jpg',
  '/images_webp/26.jpg',
  '/images_webp/27.jpg',
  '/images_webp/28.jpg',
];
---

<BaseLayout title="Gallery | Joma Concrete">
  <h1 style="text-align:center; margin:1.5rem 0;">Recent Work</h1>

  <div
    style="
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 12px;
      margin-top: 1rem;
    "
  >
    {photos.map((src) => (
      <img
        src={src}
        alt="Concrete project"
        loading="lazy"
        style="
          width: 100%;
          border-radius: 10px;
          box-shadow: 0 2px 8px rgba(0,0,0,0.06);
          transition: transform .2s ease;
        "
        onmouseover="this.style.transform='scale(1.01)'"
        onmouseout="this.style.transform='scale(1)'"
      />
    ))}
  </div>
</BaseLayout>
