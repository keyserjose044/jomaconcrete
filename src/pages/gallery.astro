---
import BaseLayout from '../layouts/BaseLayout.astro';

// Add project images to /public/images_webp and list them here:
const photos = [
  '/images_webp/1.webp',
  '/images_webp/2.webp',
  '/images_webp/3.webp',
  '/images_webp/4.webp',
  '/images_webp/5.webp',
  '/images_webp/6.webp',
  '/images_webp/7.webp',
  '/images_webp/8.webp',
  '/images_webp/9.webp',
  '/images_webp/10.webp',
  '/images_webp/11.webp',
  '/images_webp/12.webp',
  '/images_webp/13.webp',
  '/images_webp/14.webp',
  '/images_webp/15.webp',
  '/images_webp/16.webp',
  '/images_webp/17.webp',
  '/images_webp/18.webp',
  '/images_webp/19.webp',
  '/images_webp/20.webp',
  '/images_webp/21.webp',
  '/images_webp/22.webp',
  '/images_webp/23.webp',
  '/images_webp/24.webp',
  '/images_webp/25.webp',
  '/images_webp/26.webp',
  '/images_webp/27.webp',
  '/images_webp/28.webp',
];
---

<BaseLayout title="Gallery | Joma Concrete">
  <h1 style="text-align:center; margin:1.5rem 0;">Recent Work</h1>

  <div
    style="
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 12px;
      margin-top: 1rem;
    "
  >
    {photos.map((src, i) => (
      <a
  href={src}
  target="_blank"
  rel="noopener"
  style="display:block; border-radius: 10px; overflow:hidden;"
  aria-label={`Open photo ${i + 1}`}
>
  <div
    style="
      width: 100%;
      aspect-ratio: 4 / 3;
      background: rgba(0,0,0,0.03);
    "
  >
    <img
      src={src}
      alt={`Concrete project photo ${i + 1}`}
      loading="lazy"
      decoding="async"
      width="800"
      height="600"
      style="
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        transition: transform .2s ease;
      "
      onmouseover="this.style.transform='scale(1.01)'"
      onmouseout="this.style.transform='scale(1)'"
    />
  </div>
</a>
))}
  </div>
</BaseLayout>
